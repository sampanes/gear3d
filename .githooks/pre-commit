#!/bin/sh
# gear3d pre-commit gate: run the unit suite (and lint, if configured) before
# allowing a commit, and scan every staged file for local paths and emails
# (the same scan runs on every push in .github/workflows/privacy.yml).
# Enable once per clone with:
#     git config core.hooksPath .githooks
set -e
echo "pre-commit -> npm test"
npm test --silent
echo "pre-commit -> npm run lint (if present)"
npm run lint --if-present --silent

echo "pre-commit -> privacy scan of staged files (local paths, emails)"
# compressed .blend files need zstandard; Blender's bundled Python has it
py=""
for c in python python3 /c/Program\ Files/Blender\ Foundation/Blender*/*/python/bin/python.exe; do
  if "$c" -c "import zstandard" >/dev/null 2>&1; then py="$c"; break; fi
done
if [ -z "$py" ]; then
  if git diff --cached --name-only --diff-filter=ACMR | grep -qiE '\.blend$'; then
    echo "[X] a .blend is staged and no Python with zstandard was found (install Blender, or pip install zstandard)"
    exit 1
  fi
  py=python
fi
"$py" -I cad/check_private.py --staged
